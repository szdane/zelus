(* T1-flow-1 *)
(* A conjunct cannot be assumed while proving itself: position=t immediately
   leaves position^2=0, despite the first derivative vanishing at position=0. *)
let hybrid bad () = position where
  rec der ((position, velocity) : {(p:float) * (q:float) | p *. p = 0.0}) = (1.0, 0.0)
    init ((0.0, 0.0) : {(p:float) * (q:float) | p *. p = 0.0 && q = 0.0})
