let node exec () : {(vx:float)*(vu:float)*(ve:float)*(vd:float)|true} =
  let rec init xk1 = 0.
  and (xk : {xk:float|globally(xk = last_xk1)}) = last xk1

  and init errork1 = 1.
  and (errork : {errork:float|globally(errork = last_errork1)}) = last errork1
  (* and (errorkm1 : {errorkm1:float|true}) = last errork
  and (errork : {errork:float|globally(errork = r -. xk)}) = r -. xk *)

  and init derivativek1 = 0.
  and (derivativek : {derivativek:float|globally(derivativek = last_derivativek1)}) = last derivativek1
  (* and (derivativek : {derivativek:float|globally(derivativek = (errork -. errorkm1) /. dt)}) = (errork -. errorkm1) /. dt *)

  and (uk : {uk:float|globally(uk = kp *. errork -. kd *. derivativek)}) = kp *. errork -. kd *. derivativek
  
  and (xk1 : {xk1:float |globally(xk1 = xk +. uk *. dt)}) = xk +. uk *. dt

  and (errork1 : {errork1:float|globally(errork1 = r -. xk1)}) = r -. xk1

  and (derivativek1 : {derivativek1:float|globally(derivativek1 = (errork1 -. errork) /. dt)}) = (errork1 -. errork) /. dt




  and init energyk1 = 1.
  and (energyk : {energyk:float|globally((energyk = last_energyk1) && (energyk <= 1.))}) = last energyk1
  
  
  (* and (energyk1 : {venergyk1:float|venergyk1 = energyk +. 0.}) = energy_bound (energyk, errork, derivativek) *)

  (* and (energyk1 : {venergyk1:float|globallye(energyk -. 0.2 *. errork *. errork -. 0.0275 *. derivativek *. derivativek) && (energyk1 <= 1.)}) = 
  energy_bound (energyk, errork, derivativek) *)


  and (energyk1 : {energyk1:float|globally((energyk1 = errork1 *. errork1 +. 0.04 *. derivativek1 *. derivativek1) && (energyk1 <= 1.))}) = 
  errork1 *. errork1 +. 0.04 *. derivativek1 *. derivativek1

  and (energykv2 : {energykv2:float|globally(energykv2 = errork *. errork +. 0.04 *. derivativek *. derivativek)}) = energyk

  (* and (energyk1 : {energyk1:float|globally(energyk1 = energyk -. 0.2 *. errork *. errork -. 0.0275 *. derivativek *. derivativek)}) = 
  energyk -. 0.2 *. errork *. errork -. 0.0275 *. derivativek *. derivativek *)

  
  (* and (diffenergy1 : {diffenergy1:float|globally(diffenergy1 = energyk1 -. energyk)}) = 
  errork1 *. errork1 +. 0.04 *. derivativek1 *. derivativek1 -. 
  (errork *. errork +. 0.04 *. derivativek *. derivativek)

  and (dk1rf : {dk1rf:float|globally(dk1rf = derivativek1 *. dt)}) = (xk -. xk1)
  and (ek1dev : {ek1dev:float|globally(ek1dev = errork1)}) = errork +. derivativek1 *. dt
  and (ek1dev2 : {ek1dev2:float|globally(ek1dev2 = errork1)}) = errork -. uk *. dt *)


  (* and (diffenergy2 : {diffenergy2:float|globally(diffenergy2 = energyk1 -. energyk)}) = 
  (0.8 *. errork +. 0.05 *. derivativek) *. (0.8 *. errork +. 0.05 *. derivativek) +. 
  0.04 *. (-2. *. errork +. 0.5 *. derivativek) *. (-2. *. errork +. 0.5 *. derivativek) -. 
  (errork *. errork +. 0.04 *. derivativek *. derivativek) *)

  
  and (diffenergy : {diffenergy:float|globally(diffenergy = energyk1 -. energyk)}) =  -0.2 *. errork *. errork -. 0.0275 *. derivativek *. derivativek
  
  and (engerydec : {engerydec:float|globally(engerydec <= 0.)}) = energyk1 -. energyk
  
  and (en0 : {en0:float|globally(en0 = 1. *. 1. +. 0.04 *. 0. *. 0.)}) = 1.
  (* and (energy0 : {energy0:float|globally(energy0 >= energyk)}) = 1. fby energy0 *)

  (* and (en0b : {en0b:float|globally(en0b = 0.)}) = en0 -. energy0 *)


  (* and (energy0 : {energy0:float|globally(energy0 >= energyk)}) = energyk fby energy0 *)

  and (energy_bound : {energy_bound:float|globally(energy_bound <= 1.)}) = energyk
  
  and (errorbound1 : {errorbound1:float|globally(errorbound1 <= 1.)}) = errork *. errork
  and (errorbound2 : {errorbound2:float|globally(-1. <= errorbound2 && errorbound2 <= 1.)}) = errork

  and (xkbound : {xkbound:float|globally(-1 +. r <= xkbound && xkbound <= 1. +. r)}) = xk1


in xk, uk, errork, derivativek


let hybrid main () =
    let rec trigger = (period (0.1)) in
