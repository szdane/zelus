(* P discrete simple sys *)

(* Parametric version *)

let r : {r : float | globally(true)} = 1.

let dt : {dt : float | globally(0. < dt)} = 0.1 

let kp : {kp : float | globally((0. < kp) && (kp *. dt < 2.) && (kp *. dt <> 1.))} = 0.2 *. 1. /. dt

let x0 : {x0 : float|globally(true)} = 0.
let error0 : {error0 : float|globally(error0 = r -. x0)} = r -. x0

let kmin : {kmin : float|globally(kmin = 9.)} = 9.

let eps0 : {eps0 : float|globally(eps0 = 0.2)} = 0.2

let eps : {eps : float|globally((eps = (1. -. kp *. dt) ** kmin *. error0) && (true))} = (1. -. kp *. dt) ** kmin *. error0

(* let test : {test : float|globally((eps0 *. 100. <= eps *. 100. /. r))} = eps0 *)

let node exec () : {(vx:float)*(ve:float)|(true)} =
  let rec init xk1 = x0
  and (xk : {xk:float|globally(((x0 <= r) && (0. < (1. -. kp *. dt)) && (x0 <= xk && xk <= r)) || 
                               ((r < x0) && (0. < (1. -. kp *. dt)) && (r <= xk && xk <= x0)) ||
                               ((x0 <= r) && ((1. -. kp *. dt) < 0.) && (x0 <= xk && xk <= 2. *. r -. x0)) ||
                               ((r < x0) && ((1. -. kp *. dt) < 0.) && (2. *. r -. x0 <= xk && xk <= x0)))}) = last xk1

  and (errork : {errork:float|globally((errork = r -. xk))}) = r -. xk
  and (uk : {uk:float|globally(uk = kp *. errork)}) = kp *. errork
  and (xk1 : {xk1:float|globally(xk1 = xk +. uk *. dt)}) = xk +. uk *. dt

  and (abs_eps : {abs_eps:float|globally(abs_eps = (-1.) ** (kmin) *. eps)}) = (-1.) ** (kmin) *. eps


and (errorkmin : {errorkmin:float|globally((((x0 <= r) && (0. < (1. -. kp *. dt))) && ((0. <= errorkmin) && (errorkmin <= eps))) || 
                                           (((x0 > r) && (0. < (1. -. kp *. dt))) && ((eps <= errorkmin) && (errorkmin <= 0.))) ||
                                           (((x0 <= r) && (0. > (1. -. kp *. dt))) && (((-1.) *. abs_eps <= errorkmin) && (errorkmin <= abs_eps))) || 
                                           (((x0 > r) && (0. > (1. -. kp *. dt))) && ((abs_eps <= errorkmin) && (errorkmin <= (-1.) *. abs_eps))))}) = (1. -. kp *. dt) ** kmin *. errork

in xk, errork




