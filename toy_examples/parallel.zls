let hybrid simultaneous_reset () = (x, y) where
   rec der x = 1.0 init 0.0
        reset up(last x -. 1.0) -> 0.0 

  and der y = 0.0 init 1.0
        reset up(last x -. 1.0) -> (last x) +. 1.0
        
  (* and der x = 1.0 init 0.0
        reset up(last x -. 1.0) -> 0.0 *)


let dt = 0.1
let hybrid main () = () where
  rec (x, y) = simultaneous_reset ()
  and trigger = period (dt)
  and _ =
    present trigger ->
      (print_float x;
       print_string " ";
       print_float y;
       print_newline ())
