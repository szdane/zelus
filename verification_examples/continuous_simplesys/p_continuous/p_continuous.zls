in xk, uk, errork *)



let hybrid main () =
    let rec trigger = (period (0.1))
    and x, u, error = exec () 
  in present trigger -> (
                        print_float x;        
                        print_string ",";
                        print_float u;
                        print_string ",";
                        print_float error;
                        print_newline ()) else ()

