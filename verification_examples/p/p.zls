let pid ((x:{(vx:float) | true})) : {(ve:float)*(vu:float) | true} =
  let rec (error : {(error:float) | true}) = r -. x
  and (u : {(u:float) | true}) =  kp *. error
in error, u



let hybrid exec () : {(vx:float)*(vu:float)*(ve:float)| true } = 
  let rec (error : {(ve:float) | true}), (u : {(vu:float) | true}) = pid (x) 
  and x = sys (u)
in x, u, error


let hybrid main () =
  let rec trigger = period (0.1)
  and x, u, error = exec ()
  in present trigger -> (
        print_float x;
        print_string ",";
        print_float u;
        print_string ",";
        print_float error;
        print_newline ()
    )
  else () *)






