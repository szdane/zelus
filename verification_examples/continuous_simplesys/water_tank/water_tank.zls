let hybrid exec () =
  let rec der level = (if rising then 1. else -1.) init 5.
  and rising =
    if level >= 9. then false
    else if level <= 1. then true
    else true -> pre rising
  in level


let hybrid main () =
    let rec trigger = (period (0.1))
    and level = exec () 
  in present trigger -> (print_float level;        
                         print_string ",";
                         print_newline ()) else ()

