(* Test saturation *)

(* let saturate (u)= 
  (if (u <= 10.) then u else 10.)

let hybrid sys (u : {(vu:float) | true}) : {(vx:float)*(vv:float) | true} = (x, v) where
  rec der x = v init 0.
  and der v = (-.15. *. x -. 4. *. v +. u) /. 4. init 0.


let pid ((x:{(vx:float) | true}), (v:{(vv:float) | true}), (integral:{(vi:float) | true})) : {(ve:float)*(vu:float) | true} =
  let rec (error : {(error:float) | true}) = 1. -. x
  and (u : {(u:float) | true}) =  (80. *. error +. 20. *. integral -. 25. *. v)
  and uf = saturate (u)
in error, uf


let hybrid exec () : {(vx:float)*(vv:float)*(ve:float)*(vi:float)*(vu:float) | true } = (x, v, error, integral, u) where
  rec der integral = error init 0.
  and (error : {(ve:float) | true}), (u : {(vu:float) | true}) = pid (x, v, integral) 
  and x, v = sys (u)


let node test (u)=
  saturate (u)

let hybrid main () =
    let rec trigger = (period (0.1)) in
        present (trigger) -> (let x = test (20.) in
        (print_float x; print_newline ())) else () *)



