let node exec () : {(vx:float)|true} =
let rec init b = 100.
and (a : {a:float|globally(a = last_b)}) = last b
and (b : {b:float|globally(b <= 0.)}) = a -. 1.
in b



let hybrid main () =
  let rec trigger = (period (0.1)) in
    present (trigger) -> (let x = exec () in
    print_float x;
    print_newline ()) else ()