(* Descrete PID applied to sys (controlled mass spring) target at 1.0 *)

let setpoint : {v : int | true} = 1000     (* Desired setpoint *)

let sysuncertainty : {v:int | globally(v = 1)} = 1

let m : {v:int | true} = 1000 *  sysuncertainty              (* Mass *)
let k : {v:int | true} = 20 *  sysuncertainty            (* Spring stiffness *)
let b : {v:int | true} = 100 *  sysuncertainty              (* Damping coefficient *)

let piduncertainty : {v:int | globally(v = 1)} = 1

let kp : {v:int | true} = 10 *  piduncertainty          (* Proportional gain *)
let ki : {v:int | true} = 1 *  piduncertainty           (* Integral gain *)
let kd : {v:int | true} = 1 *  piduncertainty           (* Derivative gain *)
let dt : {v:int | globally(v = 1)} = 1           (* Time step *)

let a1 : {v:float | v = (b +  kd) *  dt /  m -  3} = (b +  kd) *  dt /  m -  3
let a2 : {v:float | v = 3 +  (-2 *  (b +  kd) *  dt +  (kp +  k) *  dt *  dt) /  m} = 3 +  (-2 *  (b +  kd) *  dt +  (kp +  k) *  dt *  dt) /  m      (* There is a problem with liquid fixpoint when using dt ** 2 *)
let a3 : {v:float | v = ((b +  kd) *  dt - (kp +  k) *  dt *  dt +  ki *  dt *  dt *  dt) /  m -  1} = ((b +  kd) *  dt - (kp +  k) *  dt *  dt +  ki *  dt *  dt *  dt) /  m -  1


(* Jury criteria for stability
condition1 |a3| < 1.
condition2 P(1.) = 1 +  a1 +  a2 +  a3 > 0.
condition3 P(-1.) = -1 +  a1 -  a2 +  a3 < 0.
condition4 |a2 -  a1 *  a3| < 1 -  a3 ** 2 *)

let stability_condition1 : {v:float | true} = a3
let stability_condition2 : {v:float | true} = 1 +  a1 +  a2 +  a3
let stability_condition3 : {v:float | true } = -1 +  a1 -  a2 +  a3
let stability_condition41 : {v:float | true} = 1 -  a3 *  a3 +  a1 *  a3 -  a2
let stability_condition42 : {v:float | true} = 1 -  a3 *  a3 -  a1 *  a3 +  a2

(* let stability_condition1 : {v:float | (1 > v) && (v > -1.)} = a3
let stability_condition2 : {v:float | v > 0.} = 1 +  a1 +  a2 +  a3
let stability_condition3 : {v:float | v < 0 } = -1 +  a1 -  a2 +  a3
let stability_condition41 : {v:float | v > 0.} = 1 -  a3 *  a3 +  a1 *  a3 -  a2
let stability_condition42 : {v:float | v > 0.} = 1 -  a3 *  a3 -  a1 *  a3 +  a2 *)





let node sys (u : {(vu:int) | true}) : {(vx:int)*(vv:int) | true} = 
  let rec (x : {(x:int) | true}) = last x +  last v *  dt
  and init x = 0
  and (v : {(v:int) | true}) = last v +  (-k *  last x - b *  last v +  u) *  dt /  m
  and init v = 0
in x, v


let node pid ((x:{(vx:int) | true}), (v:{(vv:int) | true})) : {(ve:int)*(vu:int) | true} =
  let rec (error : {(error:int) | true}) = setpoint - x
  and init integral_antiwindup = 0
  and (u : {(u:int) | true}) =  kp *  error +  ki *  last integral_antiwindup - kd *  v
  and (integral_antiwindup : {(integral_antiwindup:int) | true}) = last integral_antiwindup +  dt *  error
  and (u_sat : {(u_sat:int) | true}) = u
in error, u_sat



let node exec () : {(vx:int)*(vv:int)*(ve:int)*(vu:int) | true } =
  let rec init x = 0
  and init v = 0
  and error, u = pid (last x, last v)
  and x, v = sys (u)
in x, v, error, u




  let hybrid main () =
    let rec trigger = (period (0.1))  
  in present trigger -> (let x, v, _, u = exec () 
                        in
                        print_string "x= ,";
                        print_int x;
                        print_string ", v= ,";
