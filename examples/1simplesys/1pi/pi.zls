(* PI discrete simple sys xk bounded with link of last between energyk and energyk1 *)


let node exec () : {(vx:float)*(vu:float)*(ve:float)*(vi:float)|true} =
  let rec init xk1 = 0.
  and (xk : {xk:float|true}) = last xk1
  and (errork : {errork:float|true}) = last errork1


  and init integralk1 = 0.
  and (integralk : {integralk:float|true}) = last integralk1

  and (uk : {uk:float|globally(uk = kp *. errork +. ki *. integralk)}) = kp *. errork +. ki *. integralk

  and (xk1 : {xk1:float|globally(xk1 = xk +. uk *. dt)}) = xk +. uk *. dt
  
  and (errork1 : {errork1:float|globally(errork1 = r -. xk1)}) = r -. xk1
  and (integralk1 : {integralk1:float|globally(integralk1 = integralk +. errork1 *. dt)}) = integralk +. errork1 *. dt


  and init energyk1 = 0.99
  and (energyk1 : {energyk1:float|globally(energyk1 = 0.99 *. errork1 *. errork1 +. 1. *. integralk1 *. integralk1)}) = 
  0.99 *. errork1 *. errork1 +. 1. *. integralk1 *. integralk1
  and (energyk : {energyk:float|globally(energyk = last energyk1)}) = last energyk1

  (* and (energykdef : {energykdef:float|energykdef = 0.}) = energyk -. last energyk1 *)


  
  and (diffenergy1 : {diffenergy1:float|globally(diffenergy1 = energyk1 -. energyk)}) = 
  0.99 *. errork1 *. errork1 +. 1. *. integralk1 *. integralk1 -. last energyk1

  and (diffenergy2 : {diffenergy2:float|globally(diffenergy2 = energyk1 -. energyk)}) = 
  0.99 *. (0.8 *. errork -. 0.1 *. integralk) *. (0.8 *. errork -. 0.1 *. integralk) +. 
  1. *. (0.08 *. errork +. 0.99 *. integralk) *. (0.08 *. errork +. 0.99 *. integralk) -.last energyk1

  and (diffenergy3 : {diffenergy3:float|globally(diffenergy3 = energyk1 -. energyk)}) =  -0.35 *. errork *. errork -. 0.01 *. integralk *. integralk
  and (engerydec : {engerydec:float|globally(engerydec <= 0.)}) = energyk1 -. energyk
  
  and (en0 : {en0:float|globally(en0 = 0.99 *. 1. *. 1. +. 1. *. 0. *. 0.)}) = 0.99 *. 1. *. 1. +. 1. *. 0. *. 0.

  and (energy0 : {energy0:float|energy0 >= energyk}) = energyk fby energy0 (* Globally() *)

  and (energybound : {energybound:float|globally(energybound <= 0.)}) = energyk -. energy0


  (* and (errorbound : {errorbound:float|globally(errorbound <= 0.)}) = 0.99 *. errork *. errork -. energy0 *)

  
  (* and (energy0test : {energy0test:float|globally(energy0test = energy0)}) = energy0 *. energy0 *)


  (* and (xkbound1 : {xkbound1:float|globally(xkbound1 <= 0.)}) = 0.5 *. (r -. xk) *. (r -. xk) -. energy0 *. energy0 *)

  (* and (xkbound2 : {xkbound2:float|globally(xkbound2 <= 0.)}) = (r -. xk) -. energy0 *)

  (* and (xkbound3 : {xkbound3:float|globally(xkbound3 <= 0.)}) = (r -. xk) -. energy0 *)

  (* and (xkbound4 : {xkbound4:float|globally(-. 1.2 +. r <= xkbound4 && xkbound4 <= 1.2 +. r)}) = xk *)


in xk, uk, errork, integralk


let hybrid main () =
    let rec trigger = (period (0.1)) in
        present (trigger) -> (let x, u, error, integral = exec () in

        print_float x;
        print_string ",";
        print_float u;
        print_string ",";
        print_float error;
        print_string ",";
        print_float integral;
        print_newline ()

    )
  else ()
