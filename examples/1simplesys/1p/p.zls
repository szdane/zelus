(* P discrete simple sys *)

let r : {v : float | globally(v = 1.)} = 1.             (* Desired reference *)

let dt : {v : float | globally(v = 0.1)} = 0.1          (* Time step *)

let kp : {v : float | globally(v = 2.0)} = 2.           (* Proportional gain *)


let node exec () : {(vx:float)*(vu:float)*(ve:float)|true} =
  (* let rec (xk : {xk:float|globally(0. <= xk && xk <= 1.)}) = 0. fby (xk +. kp *. (r -. xk) *. dt) *)

  let rec (xk : {xk:float|globally(0. <= xk && xk <= 1.)}) = 0. fby (xk +. 2. *. (1. -. xk) *. 0.1)

  and (errork : {errork:float|globally(errork = r -. xk)})= r -. xk

  and (uk : {uk:float|globally(uk = kp *. errork)}) = kp *. errork
  
in xk, uk, errork


let hybrid main () =
    let rec trigger = (period (0.1)) in
        present (trigger) -> (let x, u, error = exec () in

        print_float x;
        print_string ",";
        print_float u;
        print_string ",";
        print_float error;
        print_newline ()

    )
  else ()



