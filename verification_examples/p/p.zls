let node exec () : {(vx:float)*(vu:float)*(ve:float)*(vd:float)*(ven:float)*(vf:float)|true} =
  let rec init xk1 = 0.
  and init errork = 1.

  and (xk : {xk:float|true}) = last xk1

  and (errork : {errork:float|globally(errork = r -. xk)}) = r -. xk

  and (errorkm1 : {errorkm1:float|true}) = last errork
  and (xkm1 : {xkm1:float|globally(xkm1 = r -. errorkm1)}) = r -. errorkm1

  and (derivativek : {derivativek:float|globally(derivativek =(errork -. errorkm1) /. dt)}) = (errork -. errorkm1) /. dt

  and (uk : {uk:float|globally(uk = kp *. errork +. kd *. derivativek)}) = kp *. errork +. kd *. derivativek

  (* and (xk1 : {xk1:float|true}) = x_bound (xkm1, xk) *)
  and (xk1 : {xk1:float |globally(xk1 = xk +. uk *. dt)}) = xk +. uk *. dt


  and (errork1 : {errork1:float|globally(errork1 = r -. xk1)}) = r -. xk1
  and (derivativek1 : {derivativek1:float|globally(derivativek1 =(errork1 -. errork) /. dt)}) = (errork1 -. errork) /. dt


  (* and (a : {a:float|a = -. (dt *. dt *. dt -. 2. *. dt *. dt *. kd *. kp +. dt *. dt *. kd -. dt *. kd *. kd +. dt *. kp *. kp -. kd *. kd *. kd -. kd *. kp *. kp)
  /. (dt *. kp *. (dt +. kd) *. (dt *. kp -. 2. *. dt +. 2. *. kd))}) = 
  -. (dt *. dt *. dt -. 2. *. dt *. dt *. kd *. kp +. dt *. dt *. kd -. dt *. kd *. kd +. dt *. kp *. kp -. kd *. kd *. kd -. kd *. kp *. kp)
  /. (dt *. kp *. (dt +. kd) *. (dt *. kp -. 2. *. dt +. 2. *. kd))

  and (b : {b:float|b = -. (2. *. kd *. (dt *. dt *. kp -. dt *. dt +. kd *. kd +. kp *. kp)) /. (kp *. (dt +. kd) *. (dt *. kp -. 2. *. dt +. 2. *. kd))}) = 
  -. (2. *. kd *. (dt *. dt *. kp -. dt *. dt +. kd *. kd +. kp *. kp)) /. (kp *. (dt +. kd) *. (dt *. kp -. 2. *. dt +. 2. *. kd))

  and (c : {c:float|c = -. (dt *. (dt *. kd *. kd -. dt *. kp *. kp +. 2. *. dt *. kp -. kd *. kd *. kd -. kd *. kp *. kp)) /. (kp *. (dt +. kd) *. (dt *. kp -. 2. *. dt +. 2. *. kd))}) = 
  -. (dt *. (dt *. kd *. kd -. dt *. kp *. kp +. 2. *. dt *. kp -. kd *. kd *. kd -. kd *. kp *. kp)) /. (kp *. (dt +. kd) *. (dt *. kp -. 2. *. dt +. 2. *. kd)) *)



  (* and init energyk = (195. /. 16.) *. 1. *. 1. +. (23. /. 16.) *. 1. *. 0. +. (91. /. 64.) *. 0. *. 0. *)

  and (energyk : {energyk:float|globally(energyk = (195. /. 16.) *. errork *. errork +. (23. /. 16.) *. errork *. derivativek +. (91. /. 64.) *. derivativek *. derivativek)}) = 
  (195. /. 16.) *. errork *. errork +. (23. /. 16.) *. errork *. derivativek +. (91. /. 64.) *. derivativek *. derivativek

  (* and (energyk1 : {energyk1:float|globally(energyk1 = (195. /. 16.) *. errork1 *. errork1 +. (23. /. 16.) *. errork1 *. derivativek1 +. (91. /. 64.) *. derivativek1 *. derivativek1)}) = 
  (195. /. 16.) *. errork1 *. errork1 +. (23. /. 16.) *. errork1 *. derivativek1 +. (91. /. 64.) *. derivativek1 *. derivativek1
  
  and (diffenergy1 : {diffenergy1:float|globally(diffenergy1 = energyk1 -. energyk)}) = 
  (195. /. 16.) *. errork1 *. errork1 +. (23. /. 16.) *. errork1 *. derivativek1 +. (91. /. 64.) *. derivativek1 *. derivativek1 -. 
  ((195. /. 16.) *. errork *. errork +. (23. /. 16.) *. errork *. derivativek +. (91. /. 64.) *. derivativek *. derivativek)
  
  and (diffenergy2 : {diffenergy2:float|globally(diffenergy2 = energyk1 -. energyk)}) = 
  (195. /. 16.) *. (0.8 *. errork -. 0.05 *. derivativek) *. (0.8 *. errork -. 0.05 *. derivativek) +. 
  (23. /. 16.) *. (0.8 *. errork -. 0.05 *. derivativek) *. ((0. -. 2.) *. errork -. 0.5 *. derivativek) +. 
  (91. /. 64.) *. ((0. -. 2.) *. errork -. 0.5 *. derivativek) *. ((0. -. 2.) *. errork -. 0.5 *. derivativek) -. 
  (195. /. 16.) *. errork *. errork -. (23. /. 16.) *. errork *. derivativek -. 
  (91. /. 64.) *. derivativek *. derivativek


  and (diffenergy3 : {diffenergy3:float|globally(diffenergy3 = 0.)}) = energyk1 -. energyk +. errork *. errork +. derivativek *. derivativek
  and (engerydec : {engerydec:float|globally(engerydec <= 0.)}) = energyk1 -. energyk *)
  
  and (en0 : {en0:float|globally(en0 = (195. /. 16.) *. 1. *. 1. +. (23. /. 16.) *. 1. *. 0. +. (91. /. 64.) *. 0. *. 0.)}) = (195. /. 16.) *. 1. *. 1. +. (23. /. 16.) *. 1. *. 0. +. (91. /. 64.) *. 0. *. 0.

  (* and (borninf : {borninf:float|borninf >= 0.}) = last energyk *)

  (* and (inf : {inf:float|inf >= 0.}) = en0 -. energyk *)



  and (energy0 : {energy0:float|energy0 = energyk}) = energyk fby 0.


  and (energybound : {energybound:float|globally(energybound <= energy0)}) = energyk
  
  and (energydecomp : {energydecomp:float|energydecomp = energyk}) = 
  (1076. /. 91.) *. errork *. errork +. (91. /. 64.) *. (derivativek +. (46. /. 91.) *. errork) *. (derivativek +. (46. /. 91.) *. errork)

  and (errorbound : {errorbound:float|globally(errorbound <= energy0)}) = (1076. /. 91.) *. errork *. errork 

  and (xkbound1 : {xkbound1:float|globally(xkbound1 <= energy0 *. (91. /. 1076.))}) = (r -. xk) *. (r -. xk)


  (* and (test : {test:float|globally(test = 12.1875 *. (91. /. 1076.))}) = 12.1875 *. (91. /. 1076.) *)
  and (xkbound2 : {xkbound2:float|globally(xkbound2 <= 1.02 *. 1.02)}) = 12.1875 *. (91. /. 1076.)

  (* and (xkbound2 : {xkbound2:float|globally(-. 1.016 +. r <= xkbound2 && xkbound2 <= 1.016 +. r)}) = xk *)


 in xk, uk, errork, derivativek, energy0, en0


let hybrid main () =
    let rec trigger = (period (0.1)) in
        present (trigger) -> (let x, u, error, derivative, en0, f = exec () in

        print_float x;
        print_string ",";
        print_float u;
        print_string ",";
        print_float error;
        print_string ",";
        print_float derivative;        
        print_string ",";
        print_float en0;
        print_string ",";
        print_float f;        
        print_newline ()
    )
  else ()



