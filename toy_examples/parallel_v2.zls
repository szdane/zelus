let hybrid simultaneous_reset () = 
   let rec der (x, y) = (1.0, 0.0) init (0.0, 1.0)
        reset up(last x -. 1.0) -> (0.0, (last x) +. 1.0) in (x,y)



let dt = 0.1
let hybrid main () = () where
  rec (x, y) = simultaneous_reset ()
  and trigger = period (dt)
  and _ =
    present trigger ->
      (print_float x;
       print_string " ";
       print_float y;
       print_newline ())