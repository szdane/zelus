(* P discrete simple sys *)

let r : {v : float|globally(v = 1.)} = 1.

let dt : {v : float|globally(v = 0.1)} = 0.1

let kp : {v : float|globally(v = 2.)} = 2.


let node exec () : {(vx:float)*(vu:float)*(ve:float)|true} =
  let rec init xk1 = 0.
and (xk : {xk:float|globally(
  ((0. <= r) &&
   (0. < (1. -. kp *. dt)) &&
   ((1. -. kp *. dt) < 1.) &&
   (0. <= xk && xk <= r))
)}) = last xk1

and (errork : {errork:float|globally(
  errork = r -. xk
)}) = r -. xk

and (uk : {uk:float|globally(
  uk = kp *. errork
)}) = kp *. errork

and (xk1 : {xk1:float|globally(
  xk1 = xk +. uk *. dt
)}) = xk +. uk *. dt
in xk, uk, errork

let hybrid main () =
    let rec trigger = (period (0.1)) in
        present (trigger) -> (let x, u, error = exec () in

        print_float x;
        print_string ",";
        print_float u;
        print_string ",";
        print_float error;
        print_newline ()

    )
  else ()
