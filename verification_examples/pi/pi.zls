(* PI discrete simple sys *)

let r : {v : float | globally(v = 1.)} = 1.            (* Desired reference *)

let kp : {v : float | globally(v = 2.)} = 2.           (* Proportional gain *)
let ki : {v : float | globally(v = 1.)} = 1.           (* Integral gain *)

let dt : {v : float | globally(v = 0.1)} = 0.1         (* Time step *)



let node exec () : {(vx:float)*(vu:float)*(ve:float)*(vi:float)|true} =
  let rec init xk1 = 0.
  and (xk : {xk:float|true}) = last xk1

  and init integralk1 = 0.
  and (integralk : {integralk:float|true}) = last integralk1

  and (errork : {errork:float|globally(errork = r -. xk)}) = r -. xk
  and (integralk1 : {integralk1:float|globally((integralk1 = integralk +. errork *. dt) && (0. <= integralk1 && integralk1 <= 0.4))}) = 
  integralkm1 +. errork *. dt



  and (uk : {uk:float|globally(uk = kp *. errork +. ki *. integralk)}) = kp *. errork +. ki *. integralk
  and (xk1 : {xk1:float|globally((xk1 = xk +. uk *. dt) && (0. <= xk1 && xk1 <= 1.2))}) = xk +. uk *. dt


in xk, uk, errork, integralk



let hybrid main () =
    let rec trigger = (period (0.1)) in
        present (trigger) -> (let x, u, error, integral = exec () in

        print_float x;
        print_string ",";
        print_float u;
        print_string ",";
        print_float error;
        print_string ",";
        print_float integral;
        print_newline ()

    )
  else ()


