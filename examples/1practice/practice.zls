(* Exemple 6: tank avec automate *)

(* Water tank automaton template code:*)

(* let min_level: { v : int | globally(v = 10)} = 10
let max_level: { v : int | globally(v = 20) } = 20
let init_level: { v : int | globally(v >= min_level && v <= max_level)} = 15
let out_rate: { v : int | globally(v = -1)} = -1
let in_rate: { v : int | globally(v >= 0 && v + out_rate > 0 && (v + out_rate < 3))} = 2
let margin: { v : int | globally(v = 1)} = 1

let node exec () =
  let rec 
    init level = 15
    and automaton_ref:
    {level : {v:int | globally(v >= min_level + margin && v <= max_level - margin)}}
    | On -> do level = last level + in_rate + out_rate unless ((last level + in_rate + out_rate + margin) > max_level) then Off
    | Off -> do level= last level + out_rate unless ((last level + out_rate - margin) < min_level) then On
    end
    in level

let hybrid main () =
    let rec trigger = (period (0.1)) in
        present (trigger) -> (let flow = exec () in
        (print_int flow; print_newline ())) else () *)




