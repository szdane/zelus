let node exec () =  
    let rec
    init delay = 0.
    and automaton_ref : {delay:{v:float | globally(v >= 0. && v <= 3.)}}
    | M1 -> do delay = 0. unless (last delay = 0. ) then M2
    | M2 -> do delay = (last delay) +. 1. unless (last delay > 2.) then M1
    end
    in delay



let hybrid main () =
  let rec trigger = period (0.1) in
  present (trigger) ->
    let delay = exec () in
    (
      print_float delay;
      print_newline ()
    )
  else ()