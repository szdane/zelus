(* T2-1-establish *)
(* position=clock^3 crosses upwards at clock=0 with BOTH du and ddu zero.
   Requiring a strict first derivative would make this real reset vacuous. *)
let hybrid bad () = position where
  rec der ((position, clock) : {(p:float) * (t:float) |
    p <= 0.0 && p = t *. t *. t}) = (3.0 *. clock *. clock, 1.0)
    init ((-1.0, -1.0) : {(p:float) * (t:float) | p = t *. t *. t})
    reset up (position) ->
      ((1.0, 1.0) : {(p:float) * (t:float) | p = t *. t *. t})
