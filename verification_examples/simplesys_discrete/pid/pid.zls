(* PID discrete simple sys *)

let r : {v : float | globally(v = 1.)} = 1.              (* Desired reference *)

let kp : {v : float | globally(v = 2.)} = 2.             (* Proportional gain *)
let ki : {v : float | globally(v = 1.)} = 1.             (* Proportional gain *)
let kd : {v : float | globally(v = 0.5)} = 0.5           (* Proportional gain *)

let dt : {v : float | globally(v = 0.1)} = 0.1           (* Time step *)
  

let node exec () : {(vx:float)*(vu:float)*(ve:float)*(vi:float)*(vd:float)|true} =
  let rec init xk1 = 0.
  and (xk : {xk:float|globally(xk = last_xk1)}) = last xk1

  and init errork1 = 1.
  and (errork : {errork:float|globally(errork = last_errork1)}) = last errork1

  and init integralk1 = 0.
  and (integralk : {integralk:float|globally(integralk = last_integralk1)}) = last integralk1

  and init derivativek1 = 0.
  and (derivativek : {derivativek:float|globally(derivativek = last_derivativek1)}) = last derivativek1

  and (uk : {uk:float|globally(uk = kp *. errork +. ki *. integralk -. kd *. derivativek)}) = kp *. errork +. ki *. integralk -. kd *. derivativek

  and (xk1 : {xk1:float|globally(xk1 = xk +. uk *. dt)}) = xk +. uk *. dt
  
  and (errork1 : {errork1:float|globally(errork1 = r -. xk1)}) = r -. xk1

  and (integralk1 : {integralk1:float|globally(integralk1 = integralk +. errork1 *. dt)}) = integralk +. errork1 *. dt

  and (derivativek1 : {derivativek1:float|globally(derivativek1 = (errork1 -. errork) /. dt)}) = (errork1 -. errork) /. dt




  and init energyk1 = 1.1375
  and (energyk : {energyk:float|globally((energyk = last_energyk1) && (true))}) = last energyk1
(* energyk <= 1.1375 *)
  and (energyk1 : {energyk1:float|globally((energyk1 = 1.1375 *. errork1 *. errork1 +. 1.25 *. integralk1 *. integralk1 
  +. 0.05 *. derivativek1 *. derivativek1 +. errork1 *. integralk1) && (true))}) = 
  1.1375 *. errork1 *. errork1 +. 1.25 *. integralk1 *. integralk1 +. 0.05 *. derivativek1 *. derivativek1 +. 1. *. errork1 *. integralk1
(* energyk1 <= 1.1375 *)
  and (energykv2 : {energykv2:float|globally(energykv2 = 0.9375 *. errork *. errork +. 1.25 *. (integralk +. 0.4 *. errork) *. (0.4 *. errork +. integralk)
   +. 0.05 *. derivativek *. derivativek)}) = energyk

  and (diffenergy1 : {diffenergy1:float|globally(diffenergy1 = energyk1 -. energyk)}) = 
  1.1375 *. errork1 *. errork1 +. 1.25 *. integralk1 *. integralk1 +. 0.05 *. derivativek1 *. derivativek1 +. 1. *. errork1 *. integralk1 -. 
  (1.1375 *. errork *. errork +. 1.25 *. integralk *. integralk +. 0.05 *. derivativek *. derivativek +. 1. *. errork *. integralk)

  and (errork1help : {errork1help:float|globally(errork1help = errork1)}) = 0.8 *. errork -. 0.1 *. integralk +. 0.05 *. derivativek
  and (integralk1help : {integralk1help:float|globally(integralk1help = integralk1)}) = 0.08 *. errork +. 0.99 *. integralk +. 0.005 *. derivativek
  and (derivativek1help : {derivativek1help:float|globally(derivativek1help = derivativek1)}) = -2. *. errork -. integralk +. 0.5 *. derivativek

  and (energyk1help : {energyk1help:float|globally(energyk1help = 1.1375 *. errork1help *. errork1help +. 1.25 *. integralk1help *. integralk1help 
  +. 0.05 *. derivativek1help *. derivativek1help +. errork1help *. integralk1help)}) = energyk1

  and (errork1sqrhelp : {errork1sqrhelp:float|globally(errork1sqrhelp = errork1 *. errork1)}) = 0.64 *. errork *. errork
    +. 0.01 *. integralk *. integralk
    +. 0.0025 *. derivativek *. derivativek
    -. 0.16 *. errork *. integralk
    +. 0.08 *. errork *. derivativek
    -. 0.01 *. integralk *. derivativek

  and (integralk1sqrhelp : {integralk1sqrhelp:float|globally(integralk1sqrhelp = integralk1 *. integralk1)}) = 0.0064 *. errork *. errork
    +. 0.9801 *. integralk *. integralk
    +. 0.000025 *. derivativek *. derivativek
    +. 0.1584 *. errork *. integralk
    +. 0.0008 *. errork *. derivativek
    +. 0.0099 *. integralk *. derivativek
  
  and (derivativek1sqrhelp : {derivativek1sqrhelp:float|globally(derivativek1sqrhelp = derivativek1 *. derivativek1)}) = 4. *. errork *. errork
    +. 1. *. integralk *. integralk
    +. 0.25 *. derivativek *. derivativek
    +. 4. *. errork *. integralk
    -. 2. *. errork *. derivativek
    -. 1. *. integralk *. derivativek

  and (errork1integralk1sqrhelp : {errork1integralk1sqrhelp:float|globally(errork1integralk1sqrhelp = errork1 *. integralk1)}) = 0.064 *. errork *. errork
    +. 0.792 *. errork *. integralk
    +. 0.004 *. errork *. derivativek
    -. 0.008 *. errork *. integralk
    -. 0.099 *. integralk *. integralk
    -. 0.0005 *. integralk *. derivativek
    +. 0.004 *. errork *. derivativek
    +. 0.0495 *. integralk *. derivativek
    +. 0.00025 *. derivativek *. derivativek

and (intermediate1 : {intermediate1:float|globally(intermediate1 = 1.1375 *. errork1sqrhelp +. 1.25 *. integralk1sqrhelp)}) = 
  0.736 *. errork *. errork
  +. 1.2365 *. integralk *. integralk
  +. 0.002875 *. derivativek *. derivativek
  +. 0.016 *. errork *. integralk
  +. 0.092 *. errork *. derivativek
  +. 0.001 *. integralk *. derivativek

and (intermediate2 : {intermediate2:float|globally(intermediate2 = 0.05 *. derivativek1sqrhelp +. errork1integralk1sqrhelp)}) = 
  0.264 *. errork *. errork
  +. 0.984 *. errork *. integralk
  -. 0.092 *. errork *. derivativek
  -. 0.099 *. integralk *. integralk
  -. 0.001 *. integralk *. derivativek
  +. 0.01275 *. derivativek *. derivativek

  and (diffenergy2 : {diffenergy2:float|globally(diffenergy2 = intermediate1 +. intermediate2 
  -. (1.1375 *. errork *. errork +. 1.25 *. integralk *. integralk +. 0.05 *. derivativek *. derivativek +. 1. *. errork *. integralk))}) = energyk1 -. energyk


  (* and (diffenergy3 : {diffenergy3:float|globally(diffenergy3 = energyk1 -. energyk)}) = 
  1.1375 *. (0.8 *. errork -. 0.1 *. integralk +. 0.05 *. derivativek) *. (0.8 *. errork -. 0.1 *. integralk +. 0.05 *. derivativek) +. 
  1.25 *. (0.08 *. errork +. 0.99 *. integralk +. 0.005 *. derivativek) *. (0.08 *. errork +. 0.99 *. integralk +. 0.005 *. derivativek) +. 
  0.05 *. (-2. *. errork -. integralk +. 0.5 *. derivativek) *. (-2. *. errork -. integralk +. 0.5 *. derivativek) +. 
  1. *. (0.8 *. errork -. 0.1 *. integralk +. 0.05 *. derivativek) *. (0.08 *. errork +. 0.99 *. integralk +. 0.005 *. derivativek) -. 
  (1.1375 *. errork *. errork +. 1.25 *. integralk *. integralk +. 0.05 *. derivativek *. derivativek +. 1. *. errork *. integralk) *)

  and (diffenergy4 : {diffenergy4:float|globally(diffenergy4 = energyk1 -. energyk)}) =  -0.1375 *. errork *. errork -. 0.0625 *. integralk *. integralk -. 0.034375 *. derivativek *. derivativek
  (* and (engerydec : {engerydec:float|globally(engerydec <= 0.)}) = energyk1 -. energyk *)


  (* and (errorkbound1 : {errorkbound1:float|globally(errorkbound1 <= 1.1375)}) = 0.9375 *. errork *. errork
  and (errorkbound2 : {errorkbound2:float|globally(errorkbound2 <= 1.1375 /. 0.9375)}) = errork *. errork
  and (errorkbound3 : {errorkbound3:float|globally(errorkbound3 <= 1.22)}) = errork *. errork
  and (errorkbound4 : {errorkbound4:float|globally(errorkbound4 <= 1.2)}) = errork

  and (xkbound : {xkbound:float|globally(-1.2 +. r <= xkbound && xkbound <= 1.2 +. r)}) = xk *)


in xk, uk, errork, integralk, derivativek

let hybrid main () =
    let rec trigger = (period (0.1)) in
        present (trigger) -> (let xk, uk, errork, integralk, derivativek = exec () in

        print_float xk;
        print_string ",";
        print_float uk;
        print_string ",";
        print_float errork;
        print_string ",";
        print_float integralk;
        print_string ",";
        print_float derivativek;
        print_newline ()

    )
  else ()
