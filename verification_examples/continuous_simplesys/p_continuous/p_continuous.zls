let hybrid exec () = 
  let rec der (x : {x:float|globally(0. <= x && x <= 1.)}) = kp *. (r -. x)
  init (0. : {v:float|globally(0. <= v)})

  and (error : {error:float|globally(error = r -. x)}) = r -. x
  and (u : {u:float|globally(u = kp *. error)}) = kp *. error
in x, u, error


let hybrid main () =
    let rec trigger = (period (0.1))
    and x, u, error = exec () 
  in present trigger -> (
                        print_float x;        
                        print_string ",";
                        print_float u;
                        print_string ",";
                        print_float error;
                        print_string ",";
                        print_float r;
                        print_newline ()) else ()

