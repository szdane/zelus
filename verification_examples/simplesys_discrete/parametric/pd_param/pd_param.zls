(* PD discrete simple sys *)

let r : {v : float |globally(true)} = 1.

let dt : {dt : float |globally((0.01 < dt) && (dt <= 0.1))} = 0.1

let kp : {kp : float |globally((0. < kp ) && (kp *. dt < 1.) && (kp *. dt < 0.3))} = 2.

let kd : {kd : float |globally((not (kd = 0.)) && (kd *. kd +. kp *. dt < 1.))} = 0.5


(* let calcenergy (alpha, beta, errork1, derivativek1, energyk, diffenergy2) : {(venk1:float)|true} =
  let (energyk1calc : {energyk1calc:float|globally((true))}) = 
    alpha *. errork1 *. errork1 +. beta *. derivativek1 *. derivativek1
in energyk1calc *)


let node exec () : {(vx:float)*(vu:float)*(ve:float)*(vd:float)|true} =
  let rec init xk1 = 0.
  and (xk : {xk:float|globally(xk = last_xk1)}) = last xk1

  and init errork1 = r
  and (errork : {errork:float|globally(errork = last_errork1)}) = last errork1

  and init derivativek1 = 0.
  and (derivativek : {derivativek:float|globally(derivativek = last_derivativek1)}) = last derivativek1

  and (uk : {uk:float|globally(uk = kp *. errork -. kd *. derivativek)}) = kp *. errork -. kd *. derivativek
  
  and (xk1 : {xk1:float |globally(xk1 = xk +. uk *. dt)}) = xk +. uk *. dt

  and (errork1 : {errork1:float|globally(errork1 = r -. xk1)}) = r -. xk1

  and (derivativek1 : {derivativek1:float|globally(derivativek1 = (errork1 -. errork) /. dt)}) = (errork1 -. errork) /. dt


  and (alpha : {alpha:float|globally((alpha = kp))}) = kp
  and (beta : {beta:float|globally((beta = (1. -. kp *. dt) *. dt))}) = (1. -. kp *. dt) *. dt
  and init energyk1bound = alpha
  and (energyk : {energyk:float|globally(energyk = last_energyk1bound)}) = last energyk1bound
  and (energyk1 : {energyk1:float|globally((energyk1 = alpha *. errork1 *. errork1 +. beta *. derivativek1 *. derivativek1))}) = 
    alpha *. errork1 *. errork1 +. beta *. derivativek1 *. derivativek1
  (* energyk1 <= alpha *)

  and (errork1dev : {errork1dev:float|globally((errork1dev = errork1) && (errork1dev = (1. -. kp *. dt) *. errork +. kd *. dt *. derivativek))}) = 
    (1. -. kp *. dt) *. errork +. kd *. dt *. derivativek
 
  and (energyk1p1 : {energyk1p1:float|globally(energyk1p1 = alpha *. errork1dev *. errork1dev)}) = alpha *. errork1dev *. errork1dev
  and (energyk1p1v2 : {energyk1p1v2:float|globally((energyk1p1v2 = energyk1p1) && 
    (energyk1p1v2 = kp *. ((1. -. kp *. dt) *. errork +. kd *. dt *. derivativek) *. errork1dev))}) = energyk1p1
  and (energyk1p1dev : {energyk1p1dev:float|globally((energyk1p1dev = energyk1p1v2) && (energyk1p1dev = kp *. 
    ((1. -. kp *. dt) *. errork +. kd *. dt *. derivativek) *. ((1. -. kp *. dt) *. errork +. kd *. dt *. derivativek)))}) = energyk1p1v2


  and (derivativek1dev : {derivativek1dev:float|globally((derivativek1dev = derivativek1) && (derivativek1dev = 0. -. kp *. errork +. kd *. derivativek))}) = 
    0. -. kp *. errork +. kd *. derivativek

  and (energyk1p2 : {energyk1p2:float|globally(energyk1p2 = beta *. derivativek1dev *. derivativek1dev)}) = beta *. derivativek1dev *. derivativek1dev
  and (energyk1p2v2 : {energyk1p2v2:float|globally((energyk1p2v2 = energyk1p2) && 
    (energyk1p2v2 = ((1. -. kp *. dt) *. dt) *. derivativek1dev *. derivativek1dev))}) = energyk1p2
  and (energyk1p2dev : {energyk1p2dev:float|globally((energyk1p2dev = energyk1p2v2) && (energyk1p2dev = (1. -. kp *. dt) *. dt 
    *. (0. -. kp *. errork +. kd *. derivativek) *. (0. -. kp *. errork +. kd *. derivativek)))}) = energyk1p2v2

 
  and (energyk1v2 : {energyk1v2:float|globally((energyk1v2 = energyk1) && (energyk1v2 = energyk1p1dev +. energyk1p2dev))}) = energyk1
 
 
  and (energyk1v3 : {energyk1v3:float|globally((energyk1v3 = energyk1v2) && 
    (energyk1v3  = kp *. (1. -. kp *. dt) *. errork *. errork +. kd *. kd *. dt *. derivativek *. derivativek))}) = energyk1v2
 
  and (energyk1v4 : {energyk1v4:float|globally((energyk1v4 = energyk1) && 
    (energyk1v4 = kp *. (1. -. kp *. dt) *. errork *. errork +. kd *. kd *. dt *. derivativek *. derivativek))}) = energyk1
 
  and (energykv2 : {energykv2:float|globally(
    (energykv2 = energyk && energykv2 = alpha *. errork *. errork +. beta *. derivativek *. derivativek))}) = energyk



  and (diffenergyv1: {diffenergyv1:float|globally(
    diffenergyv1 = kp *. (1. -. kp *. dt) *. errork *. errork +. kd *. kd *. dt *. derivativek *. derivativek
    -. (alpha *. errork *. errork +. beta *. derivativek *. derivativek))}) = energyk1v4 -. energyk
 
  and (diffenergyv1p1: {diffenergyv1p1:float|globally(
    diffenergyv1p1 = 0. -. kp *. kp *. dt *. errork *. errork)}) = 0. -. kp *. kp *. dt *. errork *. errork
  and (diffenergyv1p1ineq: {diffenergyv1p1ineq:float|(diffenergyv1p1ineq <= 0.)}) = diffenergyv1p1

  and (diffenergyv1p2: {diffenergyv1p2:float|globally(
    diffenergyv1p2 = dt *. (kd *. kd +. kp *. dt -. 1.) *. derivativek *. derivativek)}) = dt *. (kd *. kd +. kp *. dt -. 1.) *. derivativek *. derivativek
  and (diffenergyv1p2ineq: {diffenergyv1p2ineq:float|(diffenergyv1p2ineq <= 0.)}) = diffenergyv1p2

  and (diffenergyv2 : {diffenergyv2:float|globally(
    diffenergyv2 = diffenergyv1 && diffenergyv2 = diffenergyv1p1 +. diffenergyv1p2)}) = diffenergyv1

  and (diffenergy1vf: {diffenergy1vf:float|globally(diffenergy1vf = energyk1 -. energyk && diffenergy1vf <= 0.)}) = diffenergyv2


  and (energyk1bound : {energyk1bound:float|globally((energyk1bound = energyk1) && (energyk1bound <= alpha))}) = energyk1
    
  and (xkbound : {xkbound:float|globally(r -. 1. <= xkbound && xkbound <= r +. 1.)}) = xk

in xk, uk, errork, derivativek


let hybrid main () =
    let rec trigger = (period (0.1)) in
        present (trigger) -> (let xk, uk, errork, derivativek = exec () in
        print_float xk;
        print_string ",";
        print_float uk;
        print_string ",";
        print_float errork;
        print_string ",";
        print_float derivativek;        
        print_newline ()
    )
  else ()

