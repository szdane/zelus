 (* #16 Not possible to refine a variable without a calculation *)

let calc ((x : {vx:float|true}), (y : {vy:float|true})) : {z:float|true} =
  let (z : {vz:float|globally(true)}) = x +. 0.
in z

let node test () =
  let init x = 1.
  and (y : {vy:float|true}) = last x
  and (x : {vx:float|globally(vx = 1.)}) = 1.
  (* and (x : {vx:float|globally(vx = 1.)}) = 1.
  and (y : {vy:float|globally(vy = 2.)}) = 2. *)
  and (z : {vz:float|globally(true)}) = calc (x, y)
in x, y



