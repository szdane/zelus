(* P discrete simple sys reference = 1 then -1 then 1 ... *)

let dt : {v : float|globally(v = 0.1)} = 0.1          (* Time step *)

let kp : {v : float|globally(v = 2.)} = 2.           (* Proportional gain *)

let node exec () =
  let rec init counter = 0.
  and init r = 1.
  and counterm1 = last counter
  and counter = if counterm1 +. 1. > 20. then 1. else last counter +. 1.
  and (r : {r:float|true}) = if counter = 20. then -.last r else last r

  and init xk1 = 0.
  and (xk : {xk:float|globally(true)}) = last xk1

  and (errork : {errork:float|globally(errork = r -. xk)})= r -. xk
  and (uk : {uk:float|globally(uk = kp *. errork)}) = kp *. errork

  and (xk1 : {xk1:float|globally(xk1 = xk +. kp *. (r -. xk) *. dt)}) = xk +. kp *. (r -. xk) *. dt

in xk, uk, counter, r


let hybrid main () =
    let rec trigger = (period (0.1)) in
        present (trigger) -> (let x, u, counter, r = exec () in

        print_float x;
        print_string ",";
        print_float u;
        print_string ",";
        print_float counter;
        print_string ",";
        print_float r;
        print_newline ()

    )
  else ()
