(* T2-1-establish *)
let hybrid bad () = position where
  rec der ((position, velocity) : {(p:float) * (q:float) |
    globally (p *. p +. q *. q <= 1.0)}) = (velocity, -. position)
    init ((1.0, 0.0) : {(p:float) * (q:float) | p *. p +. q *. q <= 1.0})
    reset up (position) ->
      ((2.0, 0.0) : {(p:float) * (q:float) | p *. p +. q *. q <= 1.0})
