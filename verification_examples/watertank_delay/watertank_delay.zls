let minlevel:{v:float | globally(v >= 0. && v <= 15.)} = 10.

let maxlevel:{v:float | globally(v >= minlevel + 2. && v < 30.)} = 20.

let outflow:{v:float | globally(v < -0.1 && v > -0.3 && v = -0.25)} = -0.25

let margin:{v:float |
  globally(
    (v >= (-1.0 * outflow))
    && (v >= 0.0)
    && ((maxlevel - v) >= (minlevel + v))
    && v = 1.0)
} = 1.0

let maxdelay:{v:float |
  globally((maxlevel + (v * outflow)) > minlevel && v = 3.)
} = 3.

let inflow:{v:float |
  globally(
    v > 0.
    && (v + outflow) > 0.
    && (v + outflow) <= margin
    && (v + outflow) >= ((-1. * outflow) * maxdelay)
    && v <= 1.
  )
} = 1.

let node exec () =
  let rec
    init level = 15. and
    init delay = 0. and
    init netflow = 0. and 
    init state = 1

    and automaton_ref: {
      delay: {v:float |
        (v = 0. && v<=maxdelay)
        && nxt(globally(v >= 0. && v<=maxdelay
          && (v = 0. || mode = Delaystart)))
      };
      level : {v:float |
        (v = 15.)
        && nxt(globally(
          v >= minlevel
          && v <= maxlevel
          && (v >= minlevel - (outflow * (maxdelay - delay)))
          && ((v <= maxlevel - 1.) || mode = On || mode = Off)
        ))
      }; 
      netflow: {v:float | true};
      state: {v: int | globally(v = 1 || v = 2 || v = 3)}
    }

    | On ->
        do
          netflow = inflow +. outflow
        and
          level = last level +. netflow
        and
          delay = 0.
        and 
          state = 1
        unless ((last level >= maxlevel -. margin) && ((last delay) = 0.)) then Off

    | Off ->
        do
          netflow = outflow
        and
          level = last level +. netflow
        and
          delay = 0.
        and 
          state = 2
        unless
          ((last level <= minlevel -. (maxdelay *. outflow) +. margin) && (last delay = 0.))
        then Delaystart

    | Delaystart ->
        do
          netflow = outflow
        and
          level = last level +. netflow
        and
          delay = last delay +. 1.
        and state = 3
        unless ((last delay > maxdelay-.1.))
        then On
    end
  in
  level, (minlevel -. (maxdelay *. outflow) +. margin)

let hybrid main () =
  let rec trigger = period (0.1) in
  present (trigger) ->
    let (level, flow) = exec () in
    (
      print_float level;
      print_string ", ";
      print_float flow;
      print_newline ()
    )
  else ()