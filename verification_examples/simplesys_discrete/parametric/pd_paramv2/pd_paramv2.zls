(* PD discrete simple sys *)

let r : {v : float |globally(true)} = 1.

let dt : {dt : float |globally((0.01 < dt) )} = 0.1

let kp : {kp : float |globally((0. < kp ) && (kp *. dt < 1.))} = 0.2 *. 1. /. dt

let kd : {kd : float |globally((not (kd = 0.)) && (kd *. kd +. kp *. dt < 1.))} = 0.625 *. (1. -. kp *. dt)


let calc_energyk1v2 ((energyk1:{energyk1:float|globally(energyk1 = alpha *. errork1 *. errork1 +. beta *. derivativek1 *. derivativek1)}), 
                    (alpha:{alpha:float|globally(alpha = kp)}), 
                    (beta:{beta:float|globally(beta = (1. -. kp *. dt) *. dt)}),
                    (errork1dev:{errork1dev:float|globally((errork1dev = errork1) && (errork1dev = (1. -. kp *. dt) *. errork +. kd *. dt *. derivativek))}), 
                    (derivativek1dev:{derivativek1dev:float|globally((derivativek1dev = derivativek1) && (derivativek1dev = 0. -. kp *. errork +. kd *. derivativek))}), 
                    (errork1:{errork:float|true}), 
                    (derivativek1:{derivativek:float|true}), 
                    (errork:{errork:float|true}), 
                    (derivativek:{derivativek:float|true})) : 
  {energyk1v2:float|globally((energyk1v2 = energyk1) && (energyk1v2 = alpha *. errork1dev *. errork1dev +. beta *. derivativek1dev *. derivativek1dev))} =
  let (energyk1v2 : {energyk1v2:float|globally((energyk1v2 = energyk1) && 
  (energyk1v2 = alpha *. errork1dev *. errork1dev +. beta *. derivativek1dev *. derivativek1dev))}) = energyk1
in energyk1v2


let calc_energyk1vf ((energyk1v2:{energyk1v2:float|globally(energyk1v2 = alpha *. errork1dev *. errork1dev +. beta *. derivativek1dev *. derivativek1dev)}), 
                   (alpha:{alpha:float|globally(alpha = kp)}), 
                   (beta:{beta:float|globally(beta = (1. -. kp *. dt) *. dt)}),
                   (errork1dev:{errork1dev:float|globally((errork1dev = (1. -. kp *. dt) *. errork +. kd *. dt *. derivativek))}), 
                   (derivativek1dev:{derivativek1dev:float|globally((derivativek1dev = 0. -. kp *. errork +. kd *. derivativek))}), 
                   (errork:{errork:float|true}), 
                   (derivativek:{derivativek:float|true})) : 
  {energyk1vf:float|globally((energyk1vf = energyk1v2) && (energyk1vf = kp *. (1. -. kp *. dt) *. errork *. errork +. kd *. kd *. dt *. derivativek *. derivativek))} =
  let rec (energyk1vf : {energyk1vf:float|globally((energyk1vf = energyk1v2) && (energyk1vf = kp *. (1. -. kp *. dt) *. errork *. errork +. kd *. kd *. dt *. derivativek *. derivativek))}) = energyk1v2
in energyk1vf


let calc_diffenergy ((energyk1vf:{energyk1vf:float|globally((energyk1vf = energyk1) && (energyk1vf = kp *. (1. -. kp *. dt) *. errork *. errork +. kd *. kd *. dt *. derivativek *. derivativek))}), 
                    (energykv2:{energykv2:float|globally((energykv2 = energyk && energykv2 = kp *. errork *. errork +. (1. -. kp *. dt) *. dt *. derivativek *. derivativek))}),                       
                    (energyk1:{energyk1:float|true}), 
                    (energyk:{energyk:float|true}),                    
                    (errork:{errork:float|true}), 
                    (derivativek:{derivativek:float|true})) :                    
  {diffenergyvf:float|globally((diffenergyvf = energyk1 -. energyk) && (diffenergyvf <= 0.))} =
  let rec (diffenergyv1 : {diffenergyv1:float|globally((diffenergyv1 = energyk1vf -. energykv2) && 
                      (diffenergyv1 = kp *. (1. -. kp *. dt) *. errork *. errork +. kd *. kd *. dt *. derivativek *. derivativek -. 
                      (kp *. errork *. errork +. (1. -. kp *. dt) *. dt *. derivativek *. derivativek)))}) = energyk1vf -. energykv2
  and (diffenergyv2 : {diffenergyv2:float|globally((diffenergyv2 = diffenergyv1) && (diffenergyv2 = 0. -. kp *. kp *. dt *. errork *. errork +. dt *. (kd *. kd +. kp *. dt -. 1.) *. derivativek *. derivativek))}) = diffenergyv1
  and (diffenergyvf : {diffenergyvf:float|globally((diffenergyvf = energyk1 -. energyk) && (diffenergyvf <= 0.))}) = diffenergyv2
in diffenergyvf


let node exec () : {(vx:float)*(vu:float)*(ve:float)*(vd:float)|true} =
  let rec init xk1 = 0.
  and (xk : {xk:float|globally(xk = last_xk1)}) = last xk1

  and init errork1 = r
  and (errork : {errork:float|globally(errork = last_errork1)}) = last errork1

  and init derivativek1 = 0.
  and (derivativek : {derivativek:float|globally(derivativek = last_derivativek1)}) = last derivativek1

  and (uk : {uk:float|globally(uk = kp *. errork -. kd *. derivativek)}) = kp *. errork -. kd *. derivativek
  
  and (xk1 : {xk1:float |globally(xk1 = xk +. uk *. dt)}) = xk +. uk *. dt

  and (errork1 : {errork1:float|globally(errork1 = r -. xk1)}) = r -. xk1

  and (derivativek1 : {derivativek1:float|globally(derivativek1 = (errork1 -. errork) /. dt)}) = (errork1 -. errork) /. dt



  and (alpha : {alpha:float|globally(alpha = kp)}) = kp
  and (beta : {beta:float|globally(beta = (1. -. kp *. dt) *. dt)}) = (1. -. kp *. dt) *. dt
  and init energyk1bound = alpha
  and (energyk : {energyk:float|globally(energyk = last_energyk1bound)}) = last energyk1bound
  and (energyk1 : {energyk1:float|globally((energyk1 = alpha *. errork1 *. errork1 +. beta *. derivativek1 *. derivativek1))}) = 
    alpha *. errork1 *. errork1 +. beta *. derivativek1 *. derivativek1

  and (errork1dev : {errork1dev:float|globally((errork1dev = errork1) && (errork1dev = (1. -. kp *. dt) *. errork +. kd *. dt *. derivativek))}) = 
    (1. -. kp *. dt) *. errork +. kd *. dt *. derivativek
  and (derivativek1dev : {derivativek1dev:float|globally((derivativek1dev = derivativek1) && (derivativek1dev = 0. -. kp *. errork +. kd *. derivativek))}) = 
    0. -. kp *. errork +. kd *. derivativek


  and (energyk1v2 : {energyk1v2:float|globally(
    (energyk1v2 = energyk1) && (energyk1v2 = alpha *. errork1dev *. errork1dev +. beta *. derivativek1dev *. derivativek1dev))}) = 
      calc_energyk1v2(energyk1, alpha, beta, errork1dev, derivativek1dev, errork1, derivativek1, errork, derivativek)
  and (energyk1vf : {energyk1vf:float|globally(
    (energyk1vf = energyk1) && (energyk1vf = kp *. (1. -. kp *. dt) *. errork *. errork +. kd *. kd *. dt *. derivativek *. derivativek))}) = 
      calc_energyk1vf(energyk1v2, alpha, beta, errork1dev, derivativek1dev, errork, derivativek)

  and (energykv2 : {energykv2:float|globally(
    (energykv2 = energyk && energykv2 = kp *. errork *. errork +. (1. -. kp *. dt) *. dt *. derivativek *. derivativek))}) = energyk


  and (diffenergy : {diffenergy:float|globally(
    (diffenergy = energyk1 -. energyk) && (diffenergy <= 0.))}) = 
      calc_diffenergy(energyk1vf, energykv2, energyk1, energyk, errork, derivativek)


  and (energyk1bound : {energyk1bound:float|globally((energyk1bound = energyk1) && (energyk1bound <= alpha))}) = energyk1
    
  and (xkbound : {xkbound:float|globally((r -. 1. <= xkbound) && (xkbound <= r +. 1.))}) = xk

in xk, uk, errork, derivativek


let hybrid main () =
    let rec trigger = (period (0.1)) in
        present (trigger) -> (let xk, uk, errork, derivativek = exec () in
        print_float xk;
        print_string ",";
        print_float uk;
        print_string ",";
        print_float errork;
        print_string ",";
        print_float derivativek;        
        print_newline ()
    )
  else ()


