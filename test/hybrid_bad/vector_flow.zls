(* T1-flow *)
(* Assuming safety at the arbitrary flow vector would wrongly make 2*x*y=0
   follow from x*x=0. The actual solution x=t, y=1 is unsafe. *)
let hybrid bad () = position where
  rec der ((position, velocity) : {(p:float) * (q:float) |
    globally (p *. p = 0.0)}) = (velocity, 0.0)
    init ((0.0, 1.0) : {(p:float) * (q:float) | p *. p = 0.0})
