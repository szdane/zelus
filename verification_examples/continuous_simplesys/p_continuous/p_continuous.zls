let pide (x:{(vx:float) | true}) : {(error:float)|globally(error = r -. x)} =
  let rec (error : {error:float|globally(error = r -. x)}) = r -. x
  and (u : {u:float|globally(u = kp *. error)}) =  kp *. error
in error

let pidu (x:{(vx:float) | true}) : 
  {(u:float)|globally(u = kp *. error)} =
  let rec (error : {error:float|globally(error = r -. x)}) = r -. x
  and (u : {u:float|globally(u = kp *. error)}) =  kp *. error
in u


let hybrid exec () = 
  let rec trigger = (period (dt))

  (* and error, u = present(trigger) -> pid (x) init (1., 0.) *)

  (* and ((error,u) : {(errork:float)*(u:float)|globally((error = r -. x) && (u = kp *. error))}) = present(trigger) -> pid (x) init (1., 0.) *)

  (* and (error : {(errork:float)|globally(error = r -. x)}) = present(trigger) -> pide (x) init 1.
  and (u : {(u:float)|globally(u = kp *. error)}) = present(trigger) -> pidu (x) init 0. *)

  and error = present(trigger) -> pide x init 1.
  and u = present(trigger) -> pidu x init 0.  

  and der x = u init 0.

  (* and der (x : {x:float|globally(((0. <= r) && (0. < (1. -. kp *. dt)) && (0. <= xk && xk <= r)) || 
                               ((r < 0.) && (0. < (1. -. kp *. dt)) && (r <= xk && xk <= 0.)) ||
                               ((0. <= r) && ((1. -. kp *. dt) < 0.) && (0. <= xk && xk <= 2. *. r)) ||
                               ((r < 0.) && ((1. -. kp *. dt) < 0.) && (2 *. r <= xk && xk <= 0.)))}) = u init 0. *)

in x, u, error



