(* The derivative annotation is the safety property phi.
   Each expression annotation provides that segment's inductive invariant I.
   Here inductive invariant proves the lower bound; the active guard proves the upper bound. *)

let hybrid sawtooth () : {r:float | globally (0.0 <= r && r <= 1.0)} = x where
  rec der (x : {v:float | globally (0.0 <= v && v <= 1.0)}) = 2.0
    init (0.0 : {v:float | globally (0.0 <= v)})
    reset up (x -. 1.0) -> (0.0 : {v:float | globally (0.0 <= v)})

let hybrid main () = () where
  rec x = sawtooth ()
  and trigger = period (0.1)
  and _ = present trigger -> (print_float x; print_newline ())
