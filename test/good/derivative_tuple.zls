(* Tuple derivative syntax lowers to parallel scalar continuous states. *)
let hybrid tuple () = (x1, x2) where
  rec der (x1, x2) = (1.0, 2.0)
    init (0.0, 0.0)
    reset up (x1 -. 1.0) -> (0.0, 0.0)

let hybrid scalar () = (x1, x2) where
  rec der x1 = 1.0 init 0.0 reset up (x1 -. 1.0) -> 0.0
  and der x2 = 2.0 init 0.0 reset up (x1 -. 1.0) -> 0.0

let hybrid nested () = (x, y, z) where
  rec der (x, (y, z)) = (1.0, (2.0, 3.0))
    init (0.0, (0.0, 0.0))
    reset up (x -. 1.0) -> (0.0, (0.0, 0.0))

(* A product returned by a call must be evaluated once, then destructured. *)
let velocities t = (t, t +. 1.0)

let hybrid computed () = (x, y) where
  rec der (x, y) = velocities x init (0.0, 0.0)

let hybrid named () = x where
  rec der x = (1.0, 2.0) init (0.0, 0.0)
    reset up (1.0) -> (0.0, 0.0)

let hybrid separate_init () = x where
  rec init x = velocities 0.0
  and der x = velocities 1.0

let hybrid computed_reset () = (x, y) where
  rec der (x, y) = (1.0, 2.0) init (0.0, 0.0)
    reset up (x -. 1.0) -> velocities 0.0
        | up (y -. 3.0) -> velocities 1.0
