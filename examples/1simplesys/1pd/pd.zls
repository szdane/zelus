let pid ((x:{(vx:float) | true}), (v:{(vv:float) | true})) : {(ve:float)*(vd:float)*(vu:float) | true} =
  let rec (error : {(error:float) | error = r -. 5. && nxt globally(true)}) = r -. 5.
  and (derivative : {(derivative:float) | true}) = -.v
  and (u : {(u:float) | true}) =  kp *. error +. kd *. derivative
in error, derivative , u



let hybrid exec () : {(vx:float)*(vv:float)*(ve:float)*(vd:float)*(vu:float)| true } = 
  let rec (error : {(ve:float) | true}), (derivative : {(vd:float) | true}), (u : {(vu:float) | true}) = pid (x, v) 
  and x, v = sys (u)
in x, v, error, derivative, u


let hybrid main () =
  let rec trigger = period (0.1)
  and x, v, error, derivative, u = exec ()
  in present trigger -> (
        print_float x;
        print_string ",";
        print_float v;
        print_string ",";
        print_float u;
        print_string ",";
        print_float error;
        print_string ",";
        print_float derivative;        
        print_newline ()
    )
  else () *)

  





let r : {v : float |globally(v = 1.)} = 1.            (* Desired reference *)

let kp : {v : float |globally(v = 2.)} = 2.           (* Proportional gain *)
let kd : {v : float |globally(v = 0.5)} = 0.5         (* Derivative gain *)

let dt : {v : float |globally(v = 0.1)} = 0.1         (* Time step *)


let node exec () : {(vx:float)*(vu:float)*(ve:float)*(vd:float)|true} =
  (* let rec (xkm1 : {xkm1:float |globally(0. <= xkm1 && xkm1 <= 1.1)}) = 0. fby xk
  and (xk : {xk:float |globally(0. <= xk && xk <= 1.1)}) = 0. fby (1.3 *. xk -. 0.5 *. xkm1 +. 0.2) *)

  let rec init xk1 = 0.
  and (xk : {xk:float|true}) = last xk1


  and init errork = 1.
  and (errorkm1 : {errorkm1:float|true}) = last errork
  and (errork : {errork:float|globally(errork = r -. xk)}) = r -. xk

  and (derivativek : {derivativek:float|globally(derivativek =(errork -. errorkm1) /. dt)}) = (errork -. errorkm1) /. dt

  and (uk : {uk:float|globally(uk = kp *. errork -. kd *. derivativek)}) = kp *. errork -. kd *. derivativek
  
  and (xk1 : {xk1:float |globally(xk1 = xk +. uk *. dt)}) = xk +. uk *. dt


  and (errork1 : {errork1:float|globally(errork1 = r -. xk1)}) = r -. xk1
  and (derivativek1 : {derivativek1:float|globally(derivativek1 = (errork1 -. errork) /. dt)}) = (errork1 -. errork) /. dt



  (* and init energyk1 = 1.0
  and (energyk : {energyk:float|true}) = last energyk1 *)
  and (energyk : {energyk:float|globally(energyk = errork *. errork +. 0.04 *. derivativek *. derivativek)}) = 
  errork *. errork +. 0.04 *. derivativek *. derivativek
  and (energyk1 : {energyk1:float|globally(energyk1 = errork1 *. errork1 +. 0.04 *. derivativek1 *. derivativek1)}) = 
  errork1 *. errork1 +. 0.04 *. derivativek1 *. derivativek1



  and (diffenergy3 : {diffenergy3:float|globally(diffenergy3 = energyk1 -. energyk)}) =  -0.2 *. errork *. errork -. 0.0275 *. derivativek *. derivativek


  and (energyk1menk : {energyk1menk:float|globally(energyk1menk <= 1.)}) = 1. fby (energyk -. 0.2 *. errork *. errork -. 0.0275 *. derivativek *. derivativek)

  
  and (energyformula : {energyformula:float|globally(energyformula = energyk)}) = 
  errork *. errork +. 0.04 *. derivativek *. derivativek

  and (energyupper : {energyupper:float|globally(energyupper <= 1.)}) = 
  errork *. errork +. 0.04 *. derivativek *. derivativek

  and (errorenergy : {errorenergy:float|globally(errork *. errork <= energyformula)}) = 
  errork *. errork


  and (errorbound : {errorbound:float|globally(errork *. errork <= errorbound)}) = energyk




 in xk, uk, errork, derivativek


let hybrid main () =
    let rec trigger = (period (0.1)) in
        present (trigger) -> (let x, u, error, derivative = exec () in

        print_float x;
        print_string ",";
        print_float u;
        print_string ",";
        print_float error;
        print_string ",";
        print_float derivative;      
        print_newline ()
    )
  else ()
