(* power operator not implemented in liquidfixpoint this is just a syntaxe helper, kmin needs to be defined numerically. *)

let hybrid main () =
    let rec trigger = (period (0.1)) in
        present (trigger) -> (let xk, errork = exec () in

        print_float xk;
        print_string ",";
        print_float errork;
        print_string ",";
        print_float eps;
        print_string ",";
        print_float kmin;
        print_string ",";
        print_float r;
        print_newline ()) else ()



