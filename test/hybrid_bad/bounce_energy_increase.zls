(* T2-1-establish *)
(* Restitution greater than one violates the release-height energy bound. *)
let hybrid bad () = height where
  rec der ((height, velocity) : {(h:float) * (w:float) |
    0.0 <= h && h <= 1.0 && 2.0 *. h +. w *. w <= 2.0}) = (velocity, -1.0)
    init ((1.0, 0.0) : {(h:float) * (w:float) | 2.0 *. h +. w *. w <= 2.0})
    reset up (-. height) ->
      ((last height, -1.2 *. last velocity) : {(h:float) * (w:float) |
        2.0 *. h +. w *. w <= 2.0})
