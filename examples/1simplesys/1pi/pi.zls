(* PI discrete simple sys *)

let r : {v : float | globally(v = 1.)} = 1.            (* Desired reference *)

let kp : {v : float | globally(v = 2.)} = 2.           (* Proportional gain *)
let ki : {v : float | globally(v = 1.)} = 1.           (* Integral gain *)

let dt : {v : float | globally(v = 0.1)} = 0.1         (* Time step *)



(* let node exec () : {(vx:float)*(vu:float)*(ve:float)*(vi:float)|true} =
  let rec init xk1 = 0.
  and (xk : {xk:float|true}) = last xk1
  and (errork : {errork:float|globally(errork = r -. xk)}) = r -. xk


  and init integralk = 0.
  and (integralkm1 : {integralkm1:float|true}) = last integralk

  and (integralk : {integralk:float|globally(integralk = integralkm1 +. errork *. dt)}) = integralkm1 +. errork *. dt

  and (uk : {uk:float|globally(uk = kp *. errork +. ki *. integralkm1)}) = kp *. errork +. ki *. integralkm1

  and (xk1 : {xk1:float|globally(xk1 = xk +. uk *. dt)}) = xk +. uk *. dt

in xk, uk, errork, integralkm1


let hybrid main () =
    let rec trigger = (period (0.1)) in
        present (trigger) -> (let x, u, error, integral = exec () in

        print_float x;
        print_string ",";
        print_float u;
        print_string ",";
        print_float error;
        print_string ",";
        print_float integral;
        print_newline ()

    )
  else () *)



